# Copy to .env and fill in real values. DO NOT commit .env.

# --- VLM (for ingredient identification) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6   # provider-specific model id
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Nutrition provider ---
NUTRITION_PROVIDER=usda
USDA_API_KEY=                 # free key from https://fdc.nal.usda.gov/api-key-signup

# --- PostgreSQL (must match docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=foodanalyzer
POSTGRES_HOST=localhost
# Use 5433 if local PostgreSQL already uses 5432 (pgAdmin "password failed" on 5432).
POSTGRES_PORT=5433

# Used by src/foodanalyzer/config.py (asyncpg). Built from POSTGRES_* if omitted.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5433/foodanalyzer

# --- pgAdmin (docker compose service `pgadmin`) ---
PGADMIN_DEFAULT_EMAIL=admin@bytebite.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5051

# --- SE layer ---
LOG_LEVEL=INFO
NUTRITION_CACHE_TTL_SECONDS=86400
MAX_IMAGE_SIZE_MB=5
HTTP_PORT=8000
MAX_PARALLEL=10
UPLOAD_DIR=uploads
